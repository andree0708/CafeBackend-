generator client {
  provider = "prisma-client-js"
}

datasource db {
  // LOCAL dev: sqlite (hardcoded for Prisma compatibility)
  // Before deploying to Render: change provider to "postgresql" and url to env("DATABASE_URL")
  provider = "sqlite"
  url      = "file:./dev.db"
}

// NOTE: enums are replaced with String fields for SQLite compatibility.
// Valid values are enforced at the application layer (controllers/validators).
// When running on PostgreSQL in production the same schema works unchanged.

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  // role: "ADMIN" | "PRODUCER"
  role      String   @default("PRODUCER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  producer Producer?

  @@map("users")
}

model Producer {
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String?
  document  String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  farms Farm[]

  @@map("producers")
}

model Farm {
  id           Int      @id @default(autoincrement())
  name         String
  location     String
  municipality String?
  department   String?
  hectares     Float?
  altitude     Float?   // meters above sea level
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  producerId Int
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  batches Batch[]

  @@map("farms")
}

model Batch {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  harvestDate      DateTime
  processingMethod String?  // washed, natural, honey, anaerobic
  variety          String?  // caturra, castillo, geisha, colombia
  weight           Float?   // kilograms
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  farmId Int
  farm   Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  productionVariables ProductionVariables?
  coffeeEvaluation    CoffeeEvaluation?
  aiPrediction        AIPrediction?
  recommendations     Recommendation[]

  @@map("batches")
}

model ProductionVariables {
  id Int @id @default(autoincrement())

  // Climate
  avgTemperature Float? // °C
  avgRainfall    Float? // mm
  avgHumidity    Float? // %

  // Soil
  soilPH            Float?
  soilOrganicMatter Float? // %
  soilNitrogen      Float?

  // Crop management
  fertilizationFrequency String?
  pestControlType        String? // organic | chemical | integrated
  irrigationType         String? // drip | sprinkler | rainfed

  // Post-harvest
  dryingMethod    String? // sun | mechanical | raised_bed
  dryingDays      Int?
  storageMoisture Float?  // %

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batchId Int   @unique
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("production_variables")
}

model CoffeeEvaluation {
  id Int @id @default(autoincrement())

  // SCA cupping scores (0–10 each, total max 100)
  fragranceScore  Float?
  flavorScore     Float?
  aftertasteScore Float?
  acidityScore    Float?
  bodyScore       Float?
  balanceScore    Float?
  uniformityScore Float?
  cleanCupScore   Float?
  sweetnessScore  Float?
  overallScore    Float?
  totalScore      Float?

  defects        Int?
  evaluatorName  String?
  evaluationDate DateTime?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batchId Int   @unique
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("coffee_evaluations")
}

model AIPrediction {
  id Int @id @default(autoincrement())

  // status: "PENDING" | "PROCESSING" | "DONE" | "ERROR"
  status String @default("PENDING")

  predictedScore  Float?
  // qualityCategory: "SPECIALTY" | "PREMIUM" | "COMMERCIAL" | "LOW_GRADE"
  qualityCategory String?
  confidenceLevel Float?  // 0.0–1.0
  modelVersion    String?

  // Stored as JSON string (compatible with SQLite and PostgreSQL)
  inputFeatures String? // JSON
  rawOutput     String? // JSON

  errorMessage String?
  requestedAt  DateTime  @default(now())
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  batchId Int   @unique
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("ai_predictions")
}

model Recommendation {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  // category: "commercialization" | "processing" | "agronomic"
  category    String
  // priority: "low" | "medium" | "high"
  priority    String   @default("medium")
  createdAt   DateTime @default(now())

  batchId Int
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("recommendations")
}
