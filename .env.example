# Database (SQLite by default)
DATABASE_URL="file:./dev.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://cafe:cafe@localhost:5432/cafe_db?schema=public"

# JWT
JWT_SECRET="change_this_in_production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# CORS - Frontend URL
FRONTEND_URL="http://localhost:5173"

# ML service (FastAPI)
AI_SERVICE_URL="http://localhost:8001"
AI_TIMEOUT_MS=8000
# Set to "false" in production to fail loudly instead of using the fallback model.
AI_FALLBACK_ENABLED=true
