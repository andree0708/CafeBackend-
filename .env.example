# Database
# SQLite is the default and is configured directly in prisma/schema.prisma
# (url = "file:./dev.db"). No environment variable is required locally.
#
# For PostgreSQL:
#   1. In prisma/schema.prisma set:
#        provider = "postgresql"
#        url      = env("DATABASE_URL")
#   2. Uncomment and adjust the URL below.
# DATABASE_URL="postgresql://cafe:cafe@localhost:5432/cafe_db?schema=public"

# JWT
JWT_SECRET="change_this_in_production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# CORS - Frontend URL
FRONTEND_URL="http://localhost:5173"

# ML service (FastAPI)
AI_SERVICE_URL="http://localhost:8001"
AI_TIMEOUT_MS=8000
# Set to "false" in production to fail loudly instead of using the fallback model.
AI_FALLBACK_ENABLED=true

# Groq (LLM para analisis en lenguaje natural, POST /api/batches/:id/ai-analysis)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT_MS=60000
